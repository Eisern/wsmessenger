<?xml version="1.0" encoding="utf-8"?>
<!--
  Network Security Config
  ========================
  - Cleartext (http://, ws://) is blocked everywhere except localhost/emulator.
  - No certificate pinning: the app must be able to reach any entry point of the
    island the user configured, including volunteer bridges whose hostnames are
    unknown at build time. Pinning is per-hostname, so a pinned build can only
    ever talk to hostnames baked into the APK — which is the opposite of what
    multi-entry-point failover needs. See docs/internal/federation-assessment.md.
-->
<network-security-config>

    <!-- Block cleartext globally; trust only system CAs -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Allow cleartext only for Metro dev server (localhost / Android emulator) -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">10.0.3.2</domain>
    </domain-config>

</network-security-config>
