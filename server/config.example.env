# ============================================================
#  WS Messenger — Server Configuration
#  Copy this file to .env and fill in your values.
#  Lines starting with # are comments.
# ============================================================

# ------------------------------------------------------------
#  REQUIRED — the server will refuse to start without these
# ------------------------------------------------------------

# PostgreSQL connection string (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/wsapp

# JWT signing secret(s).
# Single secret:
#   JWT_SECRET=<long random string>
# Multiple secrets with key IDs for rotation (kid:secret,...):
#   JWT_SECRETS=v1:<secret1>,v2:<secret2>
#   JWT_CURRENT_KID=v1
JWT_SECRET=REPLACE_WITH_YOUR_JWT_SECRET
# JWT_SECRETS=v1:secret1,v2:secret2
# JWT_CURRENT_KID=v1

# ------------------------------------------------------------
#  APP IDENTITY
# ------------------------------------------------------------

# Public base URL of this server (no trailing slash).
# Used in: room logo full URLs, admin panel CSP WebSocket header.
APP_BASE_URL=https://messenger.example.com

# App name shown in TOTP authenticator apps (2FA QR code issuer).
APP_NAME="WS Messenger"

# ------------------------------------------------------------
#  CORS — which web origins may call the REST API
#  Comma-separated list. chrome-extension:// is always allowed.
#  Leave empty if you only use the Chrome extension (no web clients).
#
#  If this server answers on several domains (clients keep an ordered list of
#  entry points and fail over between them — see docs/self-hosting.md §8.1),
#  list every one of them here. APP_BASE_URL above stays single and canonical:
#  it only feeds the pages the server renders itself.
# ------------------------------------------------------------
CORS_ORIGINS=https://messenger.example.com

# Set to 1 only if your web frontend sends cookies with requests.
# Cannot be used together with CORS_ORIGINS=* .
CORS_ALLOW_CREDENTIALS=0

# ------------------------------------------------------------
#  JWT TOKEN LIFETIMES
# ------------------------------------------------------------

# Access token lifetime in minutes (default: 10)
ACCESS_TOKEN_EXPIRES_MIN=10

# Refresh token lifetime in minutes (default: 10080 = 7 days)
REFRESH_TOKEN_EXPIRES_MIN=10080

# Legacy single-token lifetime, kept for compatibility (default: 1440 = 24h)
# JWT_EXPIRES_MIN=1440

# ------------------------------------------------------------
#  ARGON2id PASSWORD HASHING (server-side, for user passwords)
#  Defaults are safe — only change if you know what you're doing.
# ------------------------------------------------------------

# Argon2 variant: ID (default, recommended), I, or D
ARGON2_TYPE=ID

# Memory cost in KiB (default: 65536 = 64 MiB)
ARGON2_MEMORY_COST=65536

# Time cost / iterations (default: 3)
ARGON2_TIME_COST=3

# Parallelism / threads (default: 2)
ARGON2_PARALLELISM=2

# Salt size in bytes (default: 16)
ARGON2_SALT_SIZE=16

# Hash length in bytes (default: 32)
ARGON2_HASH_LEN=32

# How many password hashes may run at once (default: 2). Hashing runs off the
# event loop so a login does not stall everyone's sockets; this cap is what
# keeps a burst of logins from holding dozens of ARGON2_MEMORY_COST buffers at
# the same time. On a 1 GB VPS leave it at 2.
# ARGON2_MAX_CONCURRENCY=2

# ------------------------------------------------------------
#  RATE LIMITS (all have safe built-in defaults)
# ------------------------------------------------------------

# RL_WS_CONNECT_IP_PER_MIN=60
# RL_WS_DM_CONNECT_IP_PER_MIN=120
# RL_WS_DM_MSG_PER_10S=25
# RL_WS_DM_MSG_IP_PER_10S=60
# RL_FEEDBACK_IP_PER_10M=5
# RL_FEEDBACK_USER_PER_10M=3
# RL_ROOMS_INVITE_IP_PER_10MIN=60
# RL_ROOMS_INVITE_USER_PER_10MIN=20
# RL_TOTP_VERIFY_PER_MIN=10
# RL_TOTP_SETUP_PER_10MIN=5
# RL_DM_DELIVERY_SECRET_IP_PER_MIN=60
# RL_DM_DELIVERY_SECRET_USER_PER_MIN=30

# ------------------------------------------------------------
#  EMAIL / FEEDBACK (optional — feedback form sends emails)
# ------------------------------------------------------------

# FEEDBACK_TO=support@yourdomain.com
# SMTP_HOST=smtp.yourmail.com
# SMTP_PORT=587
# SMTP_USER=smtp-user
# SMTP_PASS=smtp-pass
# SMTP_FROM=WS Messenger <noreply@yourdomain.com>
# SMTP_TLS=1

# ------------------------------------------------------------
#  REVERSE PROXY / CLIENT IP
# ------------------------------------------------------------

# Whether to trust X-Forwarded-For / X-Real-IP headers as the
# client IP (used for rate limiting and audit logs).
#
#   0 (default) — ignore those headers. The server records only
#                 the TCP peer IP (whatever machine connects to it
#                 directly). USE THIS if you put the server behind
#                 one or more relays for anonymity — the recorded
#                 "client IP" will be the last relay, and real end-
#                 user IPs never reach the server or its logs.
#
#   1           — read the first X-Forwarded-For entry as the
#                 client IP. Use this ONLY when a reverse proxy
#                 YOU CONTROL (e.g. nginx on the same host)
#                 terminates TLS and injects real client IPs.
#                 WARNING: when enabled, any TCP peer that can
#                 reach the app can spoof the client IP by sending
#                 X-Forwarded-For itself. Make sure the app is NOT
#                 directly reachable from the internet in this mode.
#
# TRUST_PROXY_HEADERS=0

# ------------------------------------------------------------
#  ISLAND IDENTITY — direct messages with users of other servers
#
#  scripts/bootstrap.sh fills all of this in for you. For a manual
#  install, see docs/self-hosting.md §8.3.
#
#  One backend with one database is an "island". With ISLAND_ID set,
#  users here can exchange direct messages with users of other islands:
#  each side opens a mailbox for the other's key, and the servers never
#  talk to each other. Without it every /foreign/* endpoint answers 404
#  and the server says so in its log at startup.
#
#  ISLAND_ID and ISLAND_SIGNING_KEY_B64 are pinned by every client that
#  adds a contact from here. NEVER change either once people have such
#  contacts: their clients would reject this island's address list as
#  forged. Back them up together with the rest of this file.
# ------------------------------------------------------------

# A stable id for this island, shown to users of other servers
# ("alice on messenger.example.com"). The primary domain is the natural
# choice, but from now on it is an identifier, not an address: keep it
# even if that domain is lost.
# ISLAND_ID=messenger.example.com

# Ed25519 private key (32 raw bytes, base64) that signs the island list
# served at /.well-known/wsapp-island. Generate with the backend's venv:
#   python -c "import base64; from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey as K; from cryptography.hazmat.primitives import serialization as s; print(base64.b64encode(K.generate().private_bytes(s.Encoding.Raw, s.PrivateFormat.Raw, s.NoEncryption())).decode())"
# ISLAND_SIGNING_KEY_B64=

# Every address of this island, most preferred first (clients read up
# to 8). JSON in SINGLE quotes: systemd and the shell both strip double
# quotes, which leaves invalid JSON.
# ISLAND_ENTRY_POINTS='[{"apiBase":"https://messenger.example.com","wsBase":"wss://messenger.example.com","label":""}]'

# Raise by one EVERY time ISLAND_ENTRY_POINTS or ISLAND_RELAYS changes.
# Clients refuse a list older than the newest one they have seen, which
# is what stops somebody replaying an old list at them.
# ISLAND_LIST_VERSION=1

# Relays that carry messages to this island (see relay/README.md).
# ISLAND_RELAYS='[{"id":"relay-yourname","url":"https://relay.example.net"}]'

# ------------------------------------------------------------
#  RELAY INGRESS (optional) — accept messages through relays
#  Off unless BOTH of the first two are set. See relay/README.md.
# ------------------------------------------------------------
# RELAY_TRANSPORT_KEY_B64=
# RELAY_PEERS='{"relay-yourname":"<base64 32-byte shared key>"}'
# RELAY_QUOTA_PER_10S=600

# ------------------------------------------------------------
#  ENVIRONMENT
# ------------------------------------------------------------

# Set to "prod" to enable HSTS header (Strict-Transport-Security).
# Leave as "dev" for local development.
ENV=dev
